# Скопируйте в `.env` в корне репозитория: `cp .env.example .env`
# Эти переменные подхватывает `docker compose` / `make up`.
# Локальный запуск api без Docker — см. также `apps/api/.env.example`.

# PostgreSQL (сервис db и строка DATABASE_URL в api)
POSTGRES_PASSWORD=bioauth

# Первый администратор (создаётся при старте, если администраторов ещё нет)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-admin-123

# Общий секрет api ↔ bio-engine (заголовок X-Bio-Secret). Смените вне демо.
BIO_ENGINE_SECRET=dev-bio-secret-change-me

# WebAuthn Relying Party — домен и origin интерфейса
RP_ID=localhost
RP_ORIGIN=http://localhost:3000

# Для реального домена за reverse-proxy, например:
# RP_ID=bioauth.example.kz
# RP_ORIGIN=https://bioauth.example.kz

# Ключи AES-256 для шаблонов лиц (ADR-0014). JSON: {"k1":"<base64 32 байта>"}.
# Без TEMPLATE_KEYS в разработке допустимы только с ALLOW_DEV_KEYS (не для продакшена).
# TEMPLATE_KEYS=
# TEMPLATE_ACTIVE_KEY=k1

# Публичный URL сайта для SEO / Open Graph / sitemap (на сборке web = RP_ORIGIN)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
