{
  "name": "@bioauth/web",
  "version": "3.4.0",
  "private": true,
  "description": "Интерфейс BioAuth Optimizer (Next.js, Feature-Sliced Design)",
  "author": "Daniel Mekenbaev <donniekun03@gmail.com>",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "node -e \"require('fs').rmSync('.next/dev/types',{recursive:true,force:true})\" && next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0 && steiger ./src",
    "test:e2e": "playwright test",
    "test": "vitest run"
  },
  "dependencies": {
    "@bioauth/contracts": "workspace:*",
    "@fontsource-variable/golos-text": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/react-query": "5.107.1",
    "echarts": "6.1.0",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "steiger": "0.10.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
