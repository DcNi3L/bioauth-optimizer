{
  "name": "@bioauth/api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API BioAuth Optimizer (NestJS, Clean Architecture)",
  "author": "Daniel Mekenbaev <donniekun03@gmail.com>",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "migrate": "node --env-file-if-exists=.env dist/shared/database/migrate.cli.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern=test/unit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bioauth/contracts": "workspace:*",
    "@bioauth/optimization-core": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "kysely": "0.28.19",
    "multer": "2.4.0",
    "nestjs-pino": "4.6.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@bioauth/config": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "1.4.13",
    "@types/node": "22.19.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "pino-pretty": "13.2.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "migrations"
  ]
}
