{
  "name": "@bioauth/api",
  "version": "3.2.0",
  "private": true,
  "description": "REST API BioAuth Optimizer (NestJS, Clean Architecture)",
  "author": "Daniel Mekenbaev <donniekun03@gmail.com>",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "migrate": "node --env-file-if-exists=.env dist/shared/database/migrate.cli.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern=test/unit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "rekey": "node --env-file-if-exists=.env dist/modules/biometrics/rekey.cli.js",
    "staff": "node --env-file-if-exists=.env dist/modules/identity/staff.cli.js"
  },
  "dependencies": {
    "@bioauth/contracts": "workspace:*",
    "@bioauth/optimization-core": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@scalar/api-reference": "1.77.0",
    "@simplewebauthn/server": "14.1.0",
    "kysely": "0.28.20",
    "multer": "2.5.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "10.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@bioauth/config": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "22.19.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "migrations"
  ]
}
